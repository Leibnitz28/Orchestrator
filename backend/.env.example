# Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemma / Gemini model ID served by the Gemini API (e.g. gemma-4 or gemini-2.5-flash)
GEMMA_MODEL=your_gemma_model_id_here

# Set to true for local dev without API access to skip network calls and use mock data
MOCK_MODE=true

# ElevenLabs API key for voice-ad synthesis (not needed if MOCK_MODE=true)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
